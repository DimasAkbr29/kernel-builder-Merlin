diff --git a/fs/susfs.c b/fs/susfs.c
new file mode 100644
index 000000000000..a4d599dc4e6c
--- /dev/null
+++ b/fs/susfs.c
@@ -0,0 +1,355 @@
+#include <linux/version.h>
+#include <linux/cred.h>
+#include <linux/fs.h>
